{
  "name": "pi-lossless",
  "version": "0.1.4",
  "private": true,
  "description": "Lossless Context Management for the Pi coding agent: long sessions keep working past the point where the model would forget, and every verbatim message stays searchable and readable (lcm_grep / lcm_describe / lcm_expand_query).",
  "keywords": [
    "coding-agent",
    "context",
    "lcm",
    "memory",
    "pi",
    "pi-package",
    "tanstack-intent"
  ],
  "homepage": "https://github.com/RogerNavelsaker/pi-lossless#readme",
  "bugs": "https://github.com/RogerNavelsaker/pi-lossless/issues",
  "license": "MIT",
  "author": "stainless-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RogerNavelsaker/pi-lossless.git",
    "directory": "packages/pi"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "skills"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "pack:watch": "vp pack --watch",
    "prepack": "vp pack"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "lossless-core": "workspace:*",
    "typebox": "1.4.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "pi": {
    "extensions": [
      "./dist/index.mjs"
    ]
  }
}
